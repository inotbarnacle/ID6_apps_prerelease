<?xml version="1.0" encoding="UTF-8"?>
<plugin>
  <name>MgFlasher</name>
  <type>App</type>
  <file>{pluginDir}/MgFlasher</file>
  <config>
    <autoStart>yes</autoStart>
    <dependencies><pluginAppConnector>
      <type>Etch</type><id>116</id><asyncCallbacks>yes</asyncCallbacks>
    </pluginAppConnector></dependencies>
    <parameters><DescFile>{pluginDir}/MgFlasher.xml</DescFile><ImageDBFile>{pluginDir}/MgFlasher_ALL_Images.zip</ImageDBFile></parameters>
  </config>
</plugin>
