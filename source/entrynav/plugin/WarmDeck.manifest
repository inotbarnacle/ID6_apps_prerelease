<?xml version="1.0" encoding="UTF-8"?>
<plugin>
  <name>WarmDeck</name>
  <type>App</type>
  <file>{pluginDir}/WarmDeck</file>
  <config>
    <autoStart>yes</autoStart>
    <dependencies><pluginAppConnector>
      <type>Etch</type><id>115</id><asyncCallbacks>yes</asyncCallbacks>
    </pluginAppConnector></dependencies>
    <parameters><DescFile>{pluginDir}/WarmDeck.xml</DescFile><ImageDBFile>{pluginDir}/WarmDeck_ALL_Images.zip</ImageDBFile></parameters>
  </config>
</plugin>
