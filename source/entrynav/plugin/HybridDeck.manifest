<?xml version="1.0" encoding="UTF-8"?>
<plugin>
  <name>HybridDeck</name>
  <type>App</type>
  <file>{pluginDir}/HybridDeck</file>
  <config>
    <autoStart>yes</autoStart>
    <dependencies><pluginAppConnector>
      <type>Etch</type><id>117</id><asyncCallbacks>yes</asyncCallbacks>
    </pluginAppConnector></dependencies>
    <parameters><DescFile>{pluginDir}/HybridDeck.xml</DescFile><ImageDBFile>{pluginDir}/HybridDeck_ALL_Images.zip</ImageDBFile></parameters>
  </config>
</plugin>
